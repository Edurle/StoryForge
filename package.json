{
  "name": "storyforge",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "./dev.sh start",
    "dev:stop": "./dev.sh stop",
    "dev:restart": "./dev.sh restart",
    "dev:status": "./dev.sh status",
    "setup-key": "npx tsx src/server/setup-key.ts",
    "backup": "npx tsx scripts/backup.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "eventsource-parser": "^3.0.0",
    "express": "^5.2.1",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
